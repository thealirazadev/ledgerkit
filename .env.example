# Test suite database targets. The package itself never reads env; these values
# exist only so the suite can reach a local postgres and mysql. Dummies only.

# Engine the suite runs against: pgsql or mysql
LEDGERKIT_TEST_DB=pgsql

DB_PGSQL_HOST=127.0.0.1
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=ledgerkit_test
DB_PGSQL_USERNAME=ledgerkit
DB_PGSQL_PASSWORD=secret

DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=ledgerkit_test
DB_MYSQL_USERNAME=ledgerkit
DB_MYSQL_PASSWORD=secret
